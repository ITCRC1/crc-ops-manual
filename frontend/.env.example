# Mismo-origen vía proxy: dejar VACÍO en producción para que el navegador llame a /api/*
# relativo y el rewrite lo reenvíe al backend con la cookie SSO. Definir solo para apuntar el
# navegador directo a un backend (no recomendado con SSO: la cookie no viajaría cross-origin).
NEXT_PUBLIC_API_URL=

# Destino del proxy /api/* (server-side, NO expuesto al navegador). En producción es el
# backend real; en desarrollo se puede apuntar a un backend local (p. ej. http://localhost:8000).
BACKEND_ORIGIN=https://backend-production-c4609.up.railway.app

# Interruptor de login (espejo de AUTH_HABILITADA del backend). `false` = entrar sin
# login. Se hornea en el build: cambiarla exige rebuild del frontend, no solo reinicio.
NEXT_PUBLIC_AUTH_HABILITADA=true
