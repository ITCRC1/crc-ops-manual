APP_NAME=CRC Operations Manual Hub API
ENTORNO=desarrollo

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crc_ops_manual

JWT_SECRET_KEY=cambiar-en-produccion
JWT_ALGORITMO=HS256
JWT_ACCESS_TOKEN_MINUTOS=20
JWT_REFRESH_TOKEN_DIAS=7

# Interruptor de login. `false` = app SIN autenticación: toda petición corre como
# AUTH_USUARIO_DEFAULT_EMAIL. Debe ir junto con NEXT_PUBLIC_AUTH_HABILITADA=false en el
# frontend. Para reactivar el login: AUTH_HABILITADA=true en ambos servicios.
AUTH_HABILITADA=true
AUTH_USUARIO_DEFAULT_EMAIL=Finance@thecostaricacollection.com

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

NIVEL_MINIMO_FIRMANTE=3

# Guardia SSO corporativo (sso_guard.py). Debe definirse en Railway con el MISMO valor que la
# intranet (apps.thecostaricacollection.com) que firma la cookie `crc_sso`. Sin esta variable
# la app NO arranca (falla al importar, a propósito: fail-closed).
SSO_SECRET=
